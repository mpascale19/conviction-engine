": "2026-03-31", "avail": "2026-05-16", "h": 430, "sh": 143910739, "N": 8741, "br": 4.919, "dbr": -0.553, "dh": -8.9}, {"q": "2026-06-30", "avail": "2026-08-15", "h": 509, "sh": 166113280, "N": 8857, "br": 5.747, "dbr": 0.828, "dh": 18.37}], "statements": {"n": 30, "from": "2020-10-01", "last": [{"d": "2026-11-09", "n": 0.0, "z": -1.63, "rz": -1.72, "earn": true, "q": "In healthcare, whoever owns the customer relationship wins, and that’s exactly what we’re building toward at Hims & Hers. Today, customers want real choice, real value, and a care team that knows them,", "a": "said Andrew Dudum, co-founder and CEO", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000242/hims-20260930x8xkearningsr.htm"}, {"d": "2026-08-10", "n": 1.63, "z": -0.76, "rz": -2.18, "earn": true, "q": "Hims & Hers is delivering a world-class health experience at a global scale and a reasonable price for the nearly 3 million people who rely on us for access to care. We’re proving, quarter after quarter, that helping people feel great and delivering strong results aren’t mutually exclusive,", "a": "said Andrew Dudum, co-founder and CEO", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000161/hims-20260630x8xkearningsr.htm"}, {"d": "2026-06-02", "n": 1.53, "z": null, "rz": null, "earn": false, "q": "The future of health isn’t inside of a doctor’s office. It will be integrated into the rhythm of your daily life, anticipating issues before you even see them, and adapting with you,", "a": "said Andrew Dudum, co-founder and CEO of Hims & Hers", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000091/ex991pressreleaserercfeuc.htm"}, {"d": "2026-05-11", "n": 0.0, "z": -2.65, "rz": -5.0, "earn": true, "q": "2026 is a defining year for Hims & Hers. We’re not just growing, we’re pulling away from the field on our path to becoming the world’s largest consumer health platform,", "a": "said Andrew Dudum, co-founder and CEO", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000074/hims-20260331x8xkearningsr.htm"}, {"d": "2026-03-11", "n": 8.96, "z": null, "rz": null, "earn": false, "q": "We see tremendous growth opportunities in the US with the expanding assortment of branded GLP-1 medications,", "a": "said Andrew Dudum, co-founder and CEO of Hims & Hers", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000033/ex991pressrelease.htm"}, {"d": "2026-02-23", "n": 1.33, "z": -2.39, "rz": 0.43, "earn": true, "q": "More than 2.5 million subscribers now rely on us for a healthcare experience that is both accessible and deeply personal – and we believe we’re well on our way to becoming the global leader in consumer health,", "a": "said Andrew Dudum, co-founder and CEO", "url": "https://www.sec.gov/Archives/edgar/data/1773751/000177375126000019/hims-20251231x8xkearningsr.htm"}], "now": {"d": "2026-11-09", "z": -1.63, "mood": "down"}, "say_do": {"mood": "down", "acts": "none", "clash": false, "agree": false}}, "score": {"value": 52, "verdict": {"it": "Nessuna convinzione chiara", "en": "No clear conviction"}, "confidence": "Media", "covered_pct": 80, "missing": ["guid"], "subs": [{"id": "insider", "name": {"it": "Insider", "en": "Insiders"}, "w": 35, "v": 50, "why": [{"it": "Nessun acquisto discrezionale negli ultimi 90 giorni.", "en": "No discretionary purchase in the last 90 days."}, {"it": "Flusso netto pesato sullo storico: +0.00 M$.", "en": "Net flow weighted by track record: +0.00 M$."}, {"it": "32 operazioni escluse perché non informative (piani 10b5-1, ritenute fiscali, esercizi e assegnazioni).", "en": "32 transactions excluded as uninformative (10b5-1 plans, tax withholding, exercises and awards)."}], "coverage": "Alta"}, {"id": "guid", "name": {"it": "Guidance e tono", "en": "Guidance and tone"}, "w": 20, "v": null, "why": [{"it": "Serve l'export delle trascrizioni delle call.", "en": "Needs the export of the earnings-call transcripts."}], "coverage": "Assente"}, {"id": "m