211824/prdo-ex99_1.htm"}, {"d": "2026-02-19", "n": 5.1, "z": 0.98, "rz": -0.07, "earn": true, "q": "I am proud of the educational achievements at our academic institutions that have enabled us to deliver strong 2025 results, which were supported by sustained levels of prospective student interest in our programs and high levels of student retention across all our academic institutions,", "a": "said Todd Nelson, President and Chief Executive Officer", "url": "https://www.sec.gov/Archives/edgar/data/1046568/000119312526059326/prdo-ex99_1.htm"}, {"d": "2025-11-04", "n": 3.19, "z": -0.21, "rz": 0.64, "earn": true, "q": "Operating performance across our academic institutions was ahead of our expectations, supported by strong levels of prospective student interest for our programs, and sustained levels of high student retention and engagement,", "a": "said Todd Nelson, President and Chief Executive Officer", "url": "https://www.sec.gov/Archives/edgar/data/1046568/000119312525264617/prdo-ex99_1.htm"}], "now": {"d": "2026-11-05", "z": -0.32, "mood": "usual"}, "say_do": {"mood": "usual", "acts": "none", "clash": false, "agree": false}}, "score": {"value": 44, "verdict": {"it": "Leggermente ribassista", "en": "Mildly bearish"}, "confidence": "Media", "covered_pct": 80, "missing": ["guid"], "subs": [{"id": "insider", "name": {"it": "Insider", "en": "Insiders"}, "w": 35, "v": 50, "why": [{"it": "Nessun acquisto discrezionale negli ultimi 90 giorni.", "en": "No discretionary purchase in the last 90 days."}, {"it": "Flusso netto pesato sullo storico: +0.00 M$.", "en": "Net flow weighted by track record: +0.00 M$."}, {"it": "1 operazioni escluse perché non informative (piani 10b5-1, ritenute fiscali, esercizi e assegnazioni).", "en": "1 transactions excluded as uninformative (10b5-1 plans, tax withholding, exercises and awards)."}], "coverage": "Alta"}, {"id": "guid", "name": {"it": "Guidance e tono", "en": "Guidance and tone"}, "w": 20, "v": null, "why": [{"it": "Serve l'export d