from": "2021-09-02", "last": [{"d": "2026-09-03", "n": 3.09, "z": -0.06, "rz": 2.05, "earn": true, "q": "The results of the fourth quarter and full year 2026 are a clear indication of the momentum we are achieving at Brady Corporation,", "a": "said Vineet Nargolwala, President and Chief Executive Officer", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659826000043/exhibit991-financialsx2026.htm"}, {"d": "2026-08-06", "n": 5.8, "z": null, "rz": null, "earn": false, "q": "Today marks the beginning of the next chapter for Brady as a leading industrial technology company, with enhanced capabilities and greater market access. The combination of Brady and PSS’s portfolios creates an industrial technology leader with capabilities across identification, safety, connectivity, and intelligent w…", "a": "said Brady’s President and Chief Executive Officer, Vineet Nargolwala", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659826000034/exhibit991-pressreleasex20.htm"}, {"d": "2026-05-18", "n": 1.9, "z": -0.96, "rz": -0.89, "earn": true, "q": "Our investment in research & development resulted in strong organic sales growth globally, along with a record quarter of adjusted earnings per share. New product launches over the last several years as well as data center construction drove our sales growth, which is an end market that is ideal for our high-performanc…", "a": "said Brady’s President and Chief Executive Officer, Russell R. Shaller", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659826000019/exhibit991pressrelease0430.htm"}, {"d": "2026-04-21", "n": 1.44, "z": null, "rz": null, "earn": false, "q": "The acquisition of Honeywell’s PSS business will significantly expand our portfolio into leading-edge mobility and scanning solutions, which are trusted by the largest transportation, warehousing and logistics companies in the world,", "a": "said Brady’s President and Chief Executive Officer, Russell R. Shaller", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659826000014/exhibit991pressrelease-202.htm"}, {"d": "2026-02-19", "n": 6.02, "z": 2.12, "rz": 0.36, "earn": true, "q": "This quarter marks Brady’s 20th consecutive quarter of organic sales growth, alongside a significant improvement in segment profit within both our Americas & Asia and Europe & Australia regions,", "a": "said Brady’s President and Chief Executive Officer, Russell R. Shaller", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659826000005/exhibit991pressrelease0131.htm"}, {"d": "2025-11-17", "n": 1.69, "z": -1.27, "rz": 0.07, "earn": true, "q": "Our investments in research and development continue to add value for our customers and drive organic sales growth. We reported strong organic sales growth in the Americas & Asia region, and our Europe & Australia region reported a significant improvement in segment profit in the quarter,", "a": "said Brady’s President and CEO, Russell R. Shaller", "url": "https://www.sec.gov/Archives/edgar/data/746598/000074659825000059/exhibit991pressrelease1031.htm"}], "now": {"d": "2026-09-03", "z": -0.06, "mood": "usual"}, "say_do": {"mood": "usual", "acts": "sell", "clash": false, "agree": false}}, "score": {"value": 44, "verdict": {"it": "Leggermente ribassista", "en": "Mildly bearish"}, "confidence": "Media", "covered_pct": 80, "missing": ["guid"], "subs": [{"id": "insider", "name": {"it": "Insider", "en": "Insiders"}, "w": 35, "v": 49, "why": [{"it": "Nessun acquisto discrezionale negli ultimi 90 giorni.", "en": "No discretionary purchase in the last 90 days."}, {"it": "Flusso netto pesato sullo storico: -0.62 M$.", "en": "Net flow weighted by track record: -0.62 M$."}, {"it": "24 operazioni escluse perché non informative (piani 10b5-1, ritenute fiscali, esercizi e assegnazioni).", "en": "24 transactions excluded as uninformative (10b5-1 plans, tax withholding, exercises and awards)."}], "coverage": "Alta"}, {"id": "guid", "name": {"it": "Guidance e tono", "en": "Guida